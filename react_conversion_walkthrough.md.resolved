        ├── index.css             ← All CSS custom properties, animations, component styles
        │
        ├── types/
        │   └── index.ts          ← All TypeScript interfaces
        │
        ├── hooks/
        │   └── useDarkMode.ts    ← localStorage + OS preference dark mode hook
        │
        ├── components/
        │   ├── Header.tsx        ← Blue gradient header + solar circuit + nav
        │   ├── Footer.tsx        ← Footer with brand + links + scheme details
        │   └── DarkModeToggle.tsx ← Fixed floating moon/sun button
        │
        └── pages/
            ├── Home.tsx          ← Hero + carousel + AI CTA + quick actions
            ├── AIAnalysis.tsx    ← ArcGIS map + 3D scene + Roboflow API + results
            ├── SubsidyCalculator.tsx ← Slider + dropdown + live calc
            ├── Process.tsx       ← 6-step flowchart with connectors
            └── Contact.tsx       ← Formspree form + Ably live chat
```

