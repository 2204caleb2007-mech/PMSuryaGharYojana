    ├── index.html                ← Root HTML with ArcGIS CDN + Font Awesome
    ├── vite.config.ts            ← Vite + Tailwind v4 + Flask proxy
    ├── tsconfig.json
    ├── tsconfig.app.json
    ├── package.json
    │
    └── src/
        ├── main.tsx              ← React entry point
